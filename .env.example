# Credenciais das assinaturas sao lidas automaticamente pelos SDKs oficiais:
#   Claude: ~/.claude/.credentials.json  (gerado por `claude login`)
#   Codex:  ~/.codex/auth.json           (gerado por `codex login` -> "Sign in with ChatGPT")
#
# NAO defina ANTHROPIC_API_KEY se quiser usar a assinatura Claude Pro/Max.
# Se definida, ela tem precedencia e o billing passa a ser por token.

TYPESAFE_API_KEY=sua-chave
TYPESAFE_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
JEV_CACHE_TTL=3600
WS_PORT=8080
AGENT_TIMEOUT_MS=600000
DEFAULT_PLANNER_MODEL=opus
DEFAULT_SIMPLE_MODEL=sonnet
DEFAULT_COMPLEX_MODEL=gpt-6-sol
# Vazio usa o padrao do modelo. Claude: low, medium, high, xhigh, max.
# Codex: minimal, low, medium, high, xhigh, max, ultra, persistent (depende do modelo).
DEFAULT_PLANNER_EFFORT=
DEFAULT_SIMPLE_EFFORT=
DEFAULT_COMPLEX_EFFORT=
