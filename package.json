{
  "name": "jev-orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fleet orchestrator routing tasks across Claude Code, Codex and the Jev (TypeSafe) decision API",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "jev": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "smoke:jev": "node dist/smoke/jev.smoke.js",
    "smoke:agents": "node dist/smoke/agents.smoke.js",
    "smoke:worktree": "node dist/smoke/worktree.smoke.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.285",
    "@openai/codex-sdk": "^0.159.1",
    "axios": "^1.7.9",
    "chalk": "^5.4.1",
    "uuid": "^11.0.5",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.3"
  }
}
