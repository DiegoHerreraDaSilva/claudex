{
  "name": "claudex",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Claudex - Jev routes persistent coding-agent sessions that edit your local folders directly",
  "license": "MIT",
  "author": "Diego Herrera",
  "repository": {
    "type": "git",
    "url": "https://github.com/DiegoHerreraDaSilva/claudex.git"
  },
  "keywords": [
    "claude",
    "codex",
    "agent",
    "orchestrator",
    "typesafe",
    "jev",
    "electron"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "claudex": "dist/index.js"
  },
  "main": "desktop/main.mjs",
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "start": "node dist/index.js",
    "app": "electron desktop/main.mjs",
    "app:web": "node dist/index.js app",
    "ui:check": "node scripts/team-mcp-check.mjs && node scripts/direct-ui-check.mjs",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.285",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@openai/codex-sdk": "^0.159.1",
    "axios": "^1.7.9",
    "dompurify": "^3.4.16",
    "electron-updater": "^6.3.9",
    "marked": "^18.0.14",
    "playwright-core": "^1.63.0",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "ai.claudex.app",
    "productName": "Claudex",
    "artifactName": "${productName}-${version}-setup.${ext}",
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "build/icon.png",
      "build/icon.ico",
      "package.json",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/@anthropic-ai/claude-agent-sdk-*/**",
      "**/node_modules/@openai/codex/**"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": "AppImage",
      "category": "Development"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "DiegoHerreraDaSilva",
        "repo": "claudex"
      }
    ]
  }
}
