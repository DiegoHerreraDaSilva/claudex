{
  "name": "claudex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Claudex - local-first orchestrator routing tasks across Claude Code, Codex and the Jev (TypeSafe) decision API",
  "license": "MIT",
  "author": "Diego Herrera",
  "repository": {
    "type": "git",
    "url": "https://github.com/DiegoHerreraDaSilva/claudex.git"
  },
  "keywords": [
    "claude",
    "codex",
    "agent",
    "orchestrator",
    "typesafe",
    "jev",
    "electron"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "claudex": "dist/index.js"
  },
  "main": "desktop/main.mjs",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "start": "node dist/index.js",
    "app": "electron desktop/main.mjs",
    "app:web": "node dist/index.js app",
    "dist": "electron-builder",
    "smoke:jev": "node dist/smoke/jev.smoke.js",
    "smoke:agents": "node dist/smoke/agents.smoke.js",
    "smoke:worktree": "node dist/smoke/worktree.smoke.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.285",
    "@openai/codex-sdk": "^0.159.1",
    "axios": "^1.7.9",
    "chalk": "^5.4.1",
    "uuid": "^11.0.5",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "ai.claudex.app",
    "productName": "Claudex",
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/@anthropic-ai/claude-agent-sdk-*/**",
      "**/node_modules/@openai/codex/**"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": "AppImage",
      "category": "Development"
    }
  }
}
